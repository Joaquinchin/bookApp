# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME=BookApp

# Google Books API - Obtener en: https://console.developers.google.com/
NEXT_PUBLIC_GOOGLE_API_KEY=REEMPLAZAR_CON_TU_KEY

# Base URL de la aplicación (para producción cambiar por la URL real)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas - Obtener connection string en: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Secrets - Generar strings aleatorios largos y seguros
JWT_SECRET=generar_string_aleatorio_minimo_32_caracteres
NEXTAUTH_SECRET=otro_string_aleatorio_diferente_para_auth

# Variables para Docker/Producción
NODE_ENV=production
PORT=3000